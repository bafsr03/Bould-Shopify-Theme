{{ 'bould.css' | asset_url | stylesheet_tag }}

<section class="bould-contact bould-page-hero" id="bould-contact" aria-label="Contact Bould">
  <div class="bould-page-hero__ghost" aria-hidden="true">LET'S TALK</div>

  <div class="bould-contact__inner">

    {%- comment -%} Left — copy + contact info + process {%- endcomment -%}
    <div class="bould-contact__copy">
      <span class="bould-section-label">{{ section.settings.eyebrow | default: 'Start a Project' }}</span>

      <h1 class="bould-contact__title">
        {{ section.settings.title_line1 | default: "Let's build" }}<br>
        <span class="bould-accent">{{ section.settings.title_line2 | default: 'something' }}</span><br>
        {{ section.settings.title_line3 | default: 'great.' }}
      </h1>

      <p class="bould-contact__sub">
        {{- section.settings.body | default: "Tell us about your project. We'll personally review your submission and reach back within 24 hours to schedule a discovery call." -}}
      </p>

      <a
        href="mailto:{{ section.settings.contact_email | default: 'garrett@bouldhq.com' }}"
        class="bould-contact__email"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
          <path d="M1.5 5L8 9.5L14.5 5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        {{ section.settings.contact_email | default: 'garrett@bouldhq.com' }}
      </a>

      <ol class="bould-contact__process" aria-label="What happens next">
        <li><span>01</span>Submit your project info</li>
        <li><span>02</span>We will review your message within 24 hours</li>
        <li><span>03</span>Schedule a discovery call</li>
        <li><span>04</span>We build something great together</li>
      </ol>
    </div>

    {%- comment -%} Right — Shopify contact form {%- endcomment -%}
    <div class="bould-contact__form-wrap">
      {%- form 'contact', id: 'BouldContactForm' -%}

        {%- if form.posted_successfully? -%}
          <div class="bould-contact__success">
            <div class="bould-contact__success-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="bould-contact__success-title">Message sent!</p>
            <p class="bould-contact__success-text">
              We'll review your project and follow up within 24 hours to schedule a call.
            </p>
          </div>

        {%- else -%}

          {%- if form.errors -%}
            <div class="bould-contact__error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="bould-contact__field-group">
            <div class="bould-contact__field">
              <label class="bould-contact__label" for="BC-name">Your Name</label>
              <input
                type="text"
                id="BC-name"
                name="contact[Name]"
                class="bould-contact__input"
                placeholder="Jane Smith"
                value="{{ form.name }}"
                autocomplete="name"
              >
            </div>
            <div class="bould-contact__field">
              <label class="bould-contact__label" for="BC-email">
                Email Address <span aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="BC-email"
                name="contact[email]"
                class="bould-contact__input"
                placeholder="you@example.com"
                value="{{ form.email }}"
                autocomplete="email"
                required
                aria-required="true"
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              >
            </div>
          </div>

          <div class="bould-contact__field-group">
            <div class="bould-contact__field">
              <label class="bould-contact__label" for="BC-company">Brand / Company</label>
              <input
                type="text"
                id="BC-company"
                name="contact[Brand]"
                class="bould-contact__input"
                placeholder="Your brand name"
                autocomplete="organization"
              >
            </div>
            <div class="bould-contact__field">
              <label class="bould-contact__label" for="BC-type">Project Type</label>
              <select id="BC-type" name="contact[Project Type]" class="bould-contact__select">
                <option value="" disabled selected>Select a service</option>
                <option value="Shopify / Shopify Plus Store">Shopify / Shopify Plus Store</option>
                <option value="Custom App Development">Custom App Development</option>
                <option value="Immersive 3D Store">Immersive 3D Store</option>
                <option value="Virtual Try-On / AR">Virtual Try-On / AR</option>
                <option value="Shopify Plus Migration">Shopify Plus Migration</option>
                <option value="Other / Not Sure Yet">Other / Not Sure Yet</option>
              </select>
            </div>
          </div>

          <div class="bould-contact__field">
            <label class="bould-contact__label" for="BC-budget">Estimated Budget</label>
            <select id="BC-budget" name="contact[Budget]" class="bould-contact__select">
              <option value="" disabled selected>Select a range</option>
              <option value="Under $5k">Under $5k</option>
              <option value="$5k – $15k">$5k – $15k</option>
              <option value="$15k – $50k">$15k – $50k</option>
              <option value="$50k+">$50k+</option>
              <option value="Not sure — let's talk">Not sure — let's talk</option>
            </select>
          </div>

          <div class="bould-contact__field">
            <label class="bould-contact__label" for="BC-message">Tell us about your project</label>
            <textarea
              id="BC-message"
              name="contact[body]"
              class="bould-contact__textarea"
              placeholder="What are you building? What's your timeline? Any context helps."
              rows="5"
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="bould-btn bould-btn--primary bould-contact__submit">
            Send Message
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8H14M14 8L8 2M14 8L8 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <p class="bould-contact__disclaimer">
            We'll only use your info to follow up on this project request.
          </p>

        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

<script>
(function () {
  var hw = document.querySelector('.header-wrapper');
  if (!hw) return;
  window.addEventListener('scroll', function () {
    hw.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Bould — Contact",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Start a Project"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title — line 1",
      "default": "Let's build"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title — line 2 (accent color)",
      "default": "something"
    },
    {
      "type": "text",
      "id": "title_line3",
      "label": "Title — line 3",
      "default": "great."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Tell us about your project. We'll personally review your submission and reach back within 24 hours to schedule a discovery call."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email (display only)",
      "default": "garrett@bouldhq.com",
      "info": "IMPORTANT: To receive form submissions at this address, go to Shopify Admin → Settings → Store details and set the Contact email to garrett@bouldhq.com."
    }
  ],
  "presets": [
    {
      "name": "Bould — Contact"
    }
  ]
}
{% endschema %}
