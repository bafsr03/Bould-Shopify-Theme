{% comment %} ── CHARLIE PIKE TOBACCO — Current Era Homepage ── {% endcomment %}

<style>
/* ── Reset ── */
.cpt-wrap *, .cpt-wrap *::before, .cpt-wrap *::after { box-sizing: border-box; }
.cpt-wrap a { text-decoration: none; }
.cpt-wrap img { max-width: 100%; }

/* ── Hide Bould chrome ── */
body:has(.cpt-wrap) .header-wrapper,
body:has(.cpt-wrap) .shopify-section-group-header-group,
body:has(.cpt-wrap) .footer-section,
body:has(.cpt-wrap) .shopify-section-group-footer-group,
body:has(.cpt-wrap) #shopify-section-announcement-bar,
body:has(.cpt-wrap) .bould-cursor { display: none !important; }
body:has(.cpt-wrap) #MainContent { padding-top: 0 !important; margin-top: 0 !important; }

/* ── Back bar ── */
.cpt-back-bar {
  position: sticky; top: 0; z-index: 9999;
  background: rgba(8,8,8,0.96);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(201,122,26,0.2);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(16px,4vw,40px); height: 48px; gap: 16px;
}
.cpt-back-btn {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: .62rem; letter-spacing: .22em; text-transform: uppercase;
  font-weight: 700; color: rgba(245,244,240,.5); transition: color .2s;
  font-family: inherit;
}
.cpt-back-btn:hover { color: #C97A1A; }
.cpt-back-btn svg { transition: transform .2s; }
.cpt-back-btn:hover svg { transform: translateX(-3px); }
.cpt-back-badge {
  font-size: .6rem; letter-spacing: .3em; text-transform: uppercase;
  font-weight: 700; color: #C97A1A;
}
.cpt-back-actions { display: flex; align-items: center; gap: 16px; }
.cpt-back-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .6rem; letter-spacing: .18em; text-transform: uppercase;
  font-weight: 600; color: rgba(245,244,240,.35); transition: color .2s;
  font-family: inherit;
}
.cpt-back-link:hover { color: #f5f4f0; }
.cpt-back-link--accent { color: rgba(201,122,26,.7); }
.cpt-back-link--accent:hover { color: #C97A1A; }

/* ── Header ── */
.cpt-header {
  position: absolute; top: 48px; left: 0; right: 0; z-index: 100;
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  padding: 24px clamp(16px,5vw,56px);
}
.cpt-header__nav { display: flex; align-items: center; gap: clamp(14px,2.5vw,34px); }
.cpt-header__nav--right { justify-content: flex-end; }
.cpt-header__link {
  font-size: .6rem; letter-spacing: .22em; text-transform: uppercase;
  font-weight: 600; color: rgba(245,244,240,.65); transition: color .22s;
}
.cpt-header__link:hover { color: #C97A1A; }
.cpt-header__logo { text-align: center; }
.cpt-header__logo img { height: 40px; width: auto; object-fit: contain; }
.cpt-header__icons { display: flex; align-items: center; gap: 18px; }
.cpt-header__icon-btn {
  color: rgba(245,244,240,.65); transition: color .22s;
  background: none; border: none; cursor: pointer; padding: 0; line-height: 0;
}
.cpt-header__icon-btn:hover { color: #C97A1A; }
@media(max-width:749px) {
  .cpt-header__nav--left { display: none; }
  .cpt-header { grid-template-columns: 1fr auto; }
}

/* ── Hero ── */
.cp-hero{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:#080808}
.cp-hero__bg{position:absolute;inset:0;z-index:0}
.cp-hero__bg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1;filter:brightness(0.38) saturate(0.72);transform:scale(1.06);animation:cp-bgzoom 22s ease-in-out infinite alternate}
@keyframes cp-bgzoom{from{transform:scale(1.06)}to{transform:scale(1.14)}}
.cp-hero__gradient{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(8,8,8,0.18) 0%,rgba(8,8,8,0.08) 25%,rgba(8,8,8,0.62) 65%,#080808 100%);z-index:0}
.cp-hero__vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center,transparent 40%,rgba(8,8,8,0.55) 100%);z-index:0}
.cp-hero__body{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 24px;animation:cp-body-in 1.1s cubic-bezier(0,0,0.18,1) 0.15s both}
@keyframes cp-body-in{from{opacity:0;transform:translateY(36px)}to{opacity:1;transform:translateY(0)}}
.cp-hero__logo{width:min(280px,62vw);height:auto;object-fit:contain;margin-bottom:32px;filter:drop-shadow(0 0 60px rgba(201,122,26,0.55)) drop-shadow(0 0 20px rgba(232,76,43,0.25));animation:cp-float 5.5s ease-in-out infinite}
@keyframes cp-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
.cp-hero__eyebrow{font-size:.6rem;letter-spacing:.4em;text-transform:uppercase;color:#C97A1A;font-weight:700;margin:0 0 20px;display:flex;align-items:center;gap:14px}
.cp-hero__eyebrow::before,.cp-hero__eyebrow::after{content:'';display:inline-block;width:30px;height:1px;background:rgba(201,122,26,0.45)}
.cp-hero__heading{font-size:clamp(2.6rem,7.5vw,7rem);font-weight:900;line-height:.88;letter-spacing:-.04em;text-transform:uppercase;color:#f5f4f0;margin:0 0 14px}
.cp-hero__heading span{color:#C97A1A;display:block;font-size:.5em;letter-spacing:.08em;font-weight:700;margin-top:6px}
.cp-hero__address{font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:rgba(245,244,240,.4);margin:0 0 48px;font-weight:500}
.cp-hero__btns{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
.cp-hero__btn{display:inline-block;padding:15px 38px;font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;font-weight:700;border-radius:2px;transition:all .28s ease}
.cp-hero__btn--primary{background:#C97A1A;color:#fff;border:1px solid #C97A1A}
.cp-hero__btn--primary:hover{background:#a86014;border-color:#a86014;transform:translateY(-2px);box-shadow:0 12px 36px rgba(201,122,26,0.38)}
.cp-hero__btn--secondary{background:transparent;color:#f5f4f0;border:1px solid rgba(245,244,240,0.32)}
.cp-hero__btn--secondary:hover{background:rgba(245,244,240,0.07);border-color:rgba(245,244,240,.58);transform:translateY(-2px)}
.cp-hero__ticker{position:absolute;bottom:68px;left:0;right:0;z-index:2;display:flex;align-items:center;overflow:hidden;border-top:1px solid rgba(245,244,240,.07);border-bottom:1px solid rgba(245,244,240,.07);padding:10px 0;background:rgba(8,8,8,.45);backdrop-filter:blur(8px)}
.cp-hero__ticker-track{display:flex;animation:cp-ticker 26s linear infinite;white-space:nowrap;will-change:transform}
.cp-hero__ticker-item{font-size:.58rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(245,244,240,.38);font-weight:600;padding:0 26px}
.cp-hero__ticker-item b{color:#C97A1A;font-weight:700}
@keyframes cp-ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.cp-hero__scroll{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:7px}
.cp-hero__scroll span{font-size:.54rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(245,244,240,.2)}
.cp-hero__scroll-line{width:1px;height:34px;background:linear-gradient(to bottom,rgba(201,122,26,0.65),transparent);animation:cp-scrolldrop 1.9s ease-in-out infinite}
@keyframes cp-scrolldrop{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* ── Brand Statement ── */
.cp-statement{text-align:center;max-width:1080px;margin:0 auto;padding:100px 24px}
.cp-statement__label{display:block;font-size:.66rem;letter-spacing:.32em;text-transform:uppercase;color:#C97A1A;font-weight:700;margin-bottom:28px}
.cp-statement__text{font-size:clamp(2rem,5.5vw,5rem);font-weight:800;line-height:1.05;letter-spacing:-.025em;color:#f5f4f0;margin:0;text-transform:uppercase}
.cp-statement__text em{font-style:normal;color:#C97A1A}
.cp-statement__meta{margin-top:40px;display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap}
.cp-statement__sub{font-size:.72rem;letter-spacing:.14em;color:rgba(245,244,240,.5);text-transform:uppercase}
.cp-statement__dot{width:4px;height:4px;border-radius:50%;background:#C97A1A;display:inline-block}
.cp-statement__divider{width:64px;height:2px;background:linear-gradient(90deg,#C97A1A,#E84C2B);margin:36px auto 0;display:block;border-radius:1px}

/* ── Three Pillars ── */
.cp-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;width:100%}
.cp-pillar{position:relative;aspect-ratio:3/4;overflow:hidden;background:#111}
.cp-pillar__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .85s cubic-bezier(0,0,.18,1),filter .55s ease;filter:brightness(.48) saturate(.8)}
.cp-pillar:hover .cp-pillar__img{transform:scale(1.07);filter:brightness(.36) saturate(.65)}
.cp-pillar__body{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:32px 28px;background:linear-gradient(to top,rgba(8,8,8,.95) 0%,rgba(8,8,8,.45) 45%,transparent 100%)}
.cp-pillar__num{font-size:.62rem;letter-spacing:.32em;text-transform:uppercase;color:#C97A1A;font-weight:700;margin-bottom:10px}
.cp-pillar__title{font-size:1.65rem;font-weight:800;text-transform:uppercase;color:#f5f4f0;letter-spacing:.02em;margin:0 0 10px;line-height:1}
.cp-pillar__desc{font-size:.78rem;line-height:1.62;color:rgba(245,244,240,.62);margin:0 0 16px;max-width:260px}
.cp-pillar__link{display:inline-block;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:#C97A1A;font-weight:700;border-bottom:1px solid rgba(201,122,26,.4);padding-bottom:3px;transition:color .22s,border-color .22s}
.cp-pillar:hover .cp-pillar__link{color:#fff;border-color:rgba(255,255,255,.38)}

/* ── About ── */
.cp-about{display:grid;grid-template-columns:1fr 1fr;gap:0;min-height:520px}
.cp-about__img-wrap{position:relative;overflow:hidden;min-height:340px}
.cp-about__img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.65) saturate(.85);transition:transform 1.2s cubic-bezier(0,0,.18,1)}
.cp-about__img-wrap:hover .cp-about__img{transform:scale(1.04)}
.cp-about__img-overlay{position:absolute;inset:0;background:linear-gradient(to right,rgba(8,8,8,.6) 0%,rgba(8,8,8,.15) 100%)}
.cp-about__content{background:#111111;padding:64px 56px;display:flex;flex-direction:column;justify-content:center}
.cp-about__label{font-size:.62rem;letter-spacing:.35em;text-transform:uppercase;color:#C97A1A;font-weight:700;margin-bottom:20px;display:block}
.cp-about__title{font-size:clamp(2rem,3.5vw,3.2rem);font-weight:800;text-transform:uppercase;letter-spacing:-.03em;color:#f5f4f0;margin:0 0 20px;line-height:1}
.cp-about__title span{color:#C97A1A}
.cp-about__body{font-size:.88rem;line-height:1.75;color:rgba(245,244,240,.62);margin:0 0 36px;max-width:460px}
.cp-about__stats{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:36px}
.cp-about__stat-val{font-size:1.6rem;font-weight:800;color:#C97A1A;line-height:1;display:block}
.cp-about__stat-lbl{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,244,240,.45);font-weight:600;display:block;margin-top:4px}
.cp-about__btn{display:inline-block;padding:13px 32px;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:#fff;background:#C97A1A;border:1px solid #C97A1A;border-radius:2px;transition:all .28s ease;align-self:flex-start}
.cp-about__btn:hover{background:#a86014;border-color:#a86014;transform:translateY(-2px);box-shadow:0 10px 28px rgba(201,122,26,.35)}

/* ── Newsletter ── */
.cp-newsletter-wrap{background:#080808;padding:100px 24px}
.cp-newsletter{text-align:center;max-width:700px;margin:0 auto}
.cp-newsletter__label{display:block;font-size:.65rem;letter-spacing:.3em;text-transform:uppercase;color:rgba(245,244,240,.45);margin-bottom:20px}
.cp-newsletter__title{font-size:clamp(2.2rem,5vw,4.2rem);font-weight:800;text-transform:uppercase;letter-spacing:-.02em;color:#f5f4f0;margin:0 0 10px;line-height:1}
.cp-newsletter__title span{color:#C97A1A}
.cp-newsletter__sub{font-size:.8rem;color:rgba(245,244,240,.48);letter-spacing:.08em;text-transform:uppercase;margin-bottom:40px}
.cp-newsletter__form{display:flex;gap:0;max-width:500px;margin:0 auto;border:1px solid rgba(245,244,240,.18);border-radius:2px;overflow:hidden;transition:border-color .25s ease}
.cp-newsletter__form:focus-within{border-color:#C97A1A}
.cp-newsletter__input{flex:1;background:transparent;border:none;color:#f5f4f0;font-size:.82rem;letter-spacing:.07em;padding:16px 22px;outline:none;min-width:0}
.cp-newsletter__input::placeholder{color:rgba(245,244,240,.3);text-transform:uppercase;letter-spacing:.1em}
.cp-newsletter__btn{background:#C97A1A;color:#fff;border:none;font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;padding:16px 26px;cursor:pointer;transition:background .22s ease;white-space:nowrap}
.cp-newsletter__btn:hover{background:#a86014}
.cp-divider{width:72px;height:2px;background:linear-gradient(90deg,#C97A1A,#E84C2B);margin:0 auto 40px;display:block;border-radius:1px}

/* ── Service CTA ── */
.cp-visit{text-align:center;position:relative;overflow:hidden}
.cp-visit__bg{position:absolute;inset:0;background:url('https://static.where-e.com/United_States/Charlie-Pike-Tobacco_47304e39e6f45c113448877b5333e8e1.jpg') center/cover no-repeat;filter:brightness(.2) saturate(.65);z-index:0}
.cp-visit__inner{position:relative;z-index:1;max-width:820px;margin:0 auto;padding:100px 24px}
.cp-visit__label{display:block;font-size:.65rem;letter-spacing:.32em;text-transform:uppercase;color:#C97A1A;margin-bottom:22px;font-weight:600}
.cp-visit__title{font-size:clamp(2.8rem,7vw,6.5rem);font-weight:900;text-transform:uppercase;letter-spacing:-.04em;color:#f5f4f0;margin:0 0 24px;line-height:.9}
.cp-visit__address{font-size:1rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,244,240,.72);margin:0 0 8px;font-weight:500}
.cp-visit__hours{font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:#C97A1A;margin:0 0 20px;font-weight:700}
.cp-visit__divider{width:60px;height:1px;background:rgba(201,122,26,.45);margin:0 auto 36px;display:block}
.cp-visit__desc{font-size:.88rem;line-height:1.72;color:rgba(245,244,240,.58);margin:0 auto 48px;max-width:520px}
.cp-visit__btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.cp-visit__btn{display:inline-block;padding:15px 34px;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;border-radius:2px;transition:all .26s ease}
.cp-visit__btn--primary{background:#C97A1A;color:#fff;border:1px solid #C97A1A}
.cp-visit__btn--primary:hover{background:#a86014;border-color:#a86014;transform:translateY(-2px);box-shadow:0 12px 36px rgba(201,122,26,.38)}
.cp-visit__btn--secondary{background:transparent;color:#f5f4f0;border:1px solid rgba(245,244,240,.32)}
.cp-visit__btn--secondary:hover{background:rgba(245,244,240,.07);border-color:rgba(245,244,240,.55);transform:translateY(-2px)}

/* ── Footer ── */
.cpt-footer {
  background: #080808; border-top: 1px solid rgba(201,122,26,0.12);
  padding: 56px clamp(16px,5vw,56px) 40px;
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px;
}
.cpt-footer__logo img { height: 40px; width: auto; object-fit: contain; }
.cpt-footer__nav { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; }
.cpt-footer__nav a {
  font-size: .58rem; letter-spacing: .22em; text-transform: uppercase;
  color: rgba(245,244,240,.3); font-weight: 600; transition: color .2s;
}
.cpt-footer__nav a:hover { color: #C97A1A; }
.cpt-footer__copy {
  font-size: .58rem; letter-spacing: .12em; text-transform: uppercase;
  color: rgba(245,244,240,.2); text-align: right; line-height: 1.6;
}

/* ── Responsive ── */
@media(max-width:749px) {
  .cp-pillars { grid-template-columns: 1fr; }
  .cp-about { grid-template-columns: 1fr; }
  .cp-about__content { padding: 44px 28px; }
  .cp-hero__heading { font-size: clamp(2rem,10vw,3.4rem); }
  .cp-hero__ticker { bottom: 58px; }
  .cpt-footer { grid-template-columns: 1fr; text-align: center; }
  .cpt-footer__copy { text-align: center; }
}
</style>

<div class="cpt-wrap" style="background:#080808;font-family:'Inter',sans-serif;color:#f5f4f0">

  {%- comment -%} ── BACK BAR ── {%- endcomment -%}
  <div class="cpt-back-bar">
    <a href="{{ section.settings.back_url | default: '/pages/build' }}" class="cpt-back-btn">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M11 7H3M3 7L7 3M3 7L7 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {{ section.settings.back_label | default: 'Back to Build' }}
    </a>
    <span class="cpt-back-badge">Charlie Pike Tobacco — Current Era</span>
    <div class="cpt-back-actions">
      {%- if section.settings.prev_version_url != blank -%}
        <a href="{{ section.settings.prev_version_url }}" class="cpt-back-link cpt-back-link--accent">
          &larr; Previous Version
        </a>
      {%- endif -%}
      <a href="https://ghost-vintage-6371.myshopify.com" target="_blank" rel="noopener noreferrer" class="cpt-back-link">
        Live Store
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path d="M1 9L9 1M9 1H3.5M9 1V6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  {%- comment -%} ── HEADER ── {%- endcomment -%}
  <header class="cpt-header">
    <nav class="cpt-header__nav cpt-header__nav--left">
      <a href="#" class="cpt-header__link">Tobacco</a>
      <a href="#" class="cpt-header__link">Glass</a>
      <a href="#" class="cpt-header__link">E-Cigs</a>
    </nav>
    <div class="cpt-header__logo">
      <img src="{{ 'gv-favicon.png' | asset_url }}" alt="Charlie Pike Tobacco" width="44" height="44" loading="eager">
    </div>
    <nav class="cpt-header__nav cpt-header__nav--right">
      <a href="#" class="cpt-header__link">Accessories</a>
      <a href="#" class="cpt-header__link">About</a>
      <div class="cpt-header__icons">
        <button class="cpt-header__icon-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="7.5" cy="7.5" r="5" stroke="currentColor" stroke-width="1.4"/><path d="M11.5 11.5L15.5 15.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </button>
        <button class="cpt-header__icon-btn" aria-label="Cart">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 2h2l2 8h7l2-6H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8" cy="14" r="1" fill="currentColor"/><circle cx="13" cy="14" r="1" fill="currentColor"/></svg>
        </button>
      </div>
    </nav>
  </header>

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <div class="cp-hero">
    <div class="cp-hero__bg">
      <img src="{{ 'gv-heroimg.png' | asset_url }}" alt="" class="cp-hero__bg-img" loading="eager" fetchpriority="high">
      <div class="cp-hero__gradient"></div>
      <div class="cp-hero__vignette"></div>
    </div>
    <div class="cp-hero__body">
      <img src="{{ 'gv-cp-logo.png' | asset_url }}" alt="Charlie Pike Tobacco" class="cp-hero__logo" width="280" height="140" loading="eager">
      <p class="cp-hero__eyebrow">Seattle &middot; Capitol Hill</p>
      <h1 class="cp-hero__heading">Charlie Pike<span>Tobacco</span></h1>
      <p class="cp-hero__address">611 E Pike St &middot; Seattle, WA 98122 &middot; Open Daily 9AM&ndash;11PM</p>
      <div class="cp-hero__btns">
        <a href="#" class="cp-hero__btn cp-hero__btn--primary">Shop Now</a>
        <a href="#" class="cp-hero__btn cp-hero__btn--secondary">Visit Us</a>
      </div>
    </div>
    <div class="cp-hero__ticker" aria-hidden="true">
      <div class="cp-hero__ticker-track">
        <span class="cp-hero__ticker-item"><b>Cigarettes</b></span><span class="cp-hero__ticker-item">&middot;</span>
        <span class="cp-hero__ticker-item"><b>Cigars</b></span><span class="cp-hero__ticker-item">&middot;</span>
