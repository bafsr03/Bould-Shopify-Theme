<footer class="bould-footer" aria-label="Site footer">

  {%- comment -%} ── CTA HERO ── {%- endcomment -%}
  <div class="bould-footer__hero" id="bould-footer-hero">
    <div class="bould-footer__hero-glow" id="bould-footer-glow" aria-hidden="true"></div>
    <div class="bould-footer__hero-inner">
      <p class="bould-footer__eyebrow bould-reveal">
        {{ section.settings.eyebrow | default: "Let's build together" }}
      </p>
      <h2 class="bould-footer__headline">
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ section.settings.headline_line1 | default: 'Ready to go' }}</span></span>
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner bould-footer__headline-accent">{{ section.settings.headline_line2 | default: '3D?' }}</span></span>
      </h2>
      <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="bould-btn bould-btn--primary bould-footer__cta bould-reveal">
        {{ section.settings.cta_label | default: 'Book a Demo' }}
        <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  {%- comment -%} ── LINKS ROW ── {%- endcomment -%}
  <div class="bould-footer__body">

    {%- comment -%} Brand col {%- endcomment -%}
    <div class="bould-footer__brand">
      <span class="bould-footer__logo">BOULD</span>
      <p class="bould-footer__tagline">
        {{ section.settings.tagline | default: 'Retail tech. 3D stores. Virtual try-on.' }}
      </p>
      {%- comment -%} Social icons {%- endcomment -%}
      <div class="bould-footer__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="bould-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" class="bould-footer__social-link" aria-label="X / Twitter" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L2.25 2.25h6.908l4.258 5.63 4.828-5.63Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_linkedin_link != blank -%}
          <a href="{{ settings.social_linkedin_link }}" class="bould-footer__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="bould-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.53V6.77a4.85 4.85 0 0 1-1.02-.08Z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Nav cols from blocks {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_col' -%}
        <nav class="bould-footer__nav-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="bould-footer__nav-heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="bould-footer__nav-list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}" class="bould-footer__nav-link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endfor -%}

  </div>

  {%- comment -%} ── BOTTOM BAR ── {%- endcomment -%}
  <div class="bould-footer__bottom">
    <small class="bould-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small>
    <div class="bould-footer__bottom-links">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <a href="{{ policy.url }}" class="bould-footer__policy-link">{{ policy.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

</footer>

<script>
(function() {
  var hero = document.getElementById('bould-footer-hero');
  var glow = document.getElementById('bould-footer-glow');
  if (!hero || !glow) return;
  hero.addEventListener('mousemove', function(e) {
    var rect = hero.getBoundingClientRect();
    var x = ((e.clientX - rect.left) / rect.width  * 100).toFixed(1);
    var y = ((e.clientY - rect.top)  / rect.height * 100).toFixed(1);
    glow.style.background =
      'radial-gradient(600px circle at ' + x + '% ' + y + '%, rgba(139,92,246,0.18) 0%, transparent 65%)';
  });
  hero.addEventListener('mouseleave', function() {
    glow.style.background = 'none';
  });
})();
</script>

{% schema %}
{
  "name": "Bould — Footer",
  "tag": "section",
  "settings": [
    { "type": "text",    "id": "eyebrow",        "label": "Eyebrow text",     "default": "Let's build together" },
    { "type": "text",    "id": "headline_line1",  "label": "Headline line 1",  "default": "Ready to go" },
    { "type": "text",    "id": "headline_line2",  "label": "Headline line 2",  "default": "3D?" },
    { "type": "url",     "id": "cta_url",         "label": "CTA link",         "default": "/pages/contact" },
    { "type": "text",    "id": "cta_label",       "label": "CTA button label", "default": "Book a Demo" },
    { "type": "text",    "id": "tagline",         "label": "Brand tagline",    "default": "Retail tech. 3D stores. Virtual try-on." }
  ],
  "blocks": [
    {
      "type": "nav_col",
      "name": "Nav column",
      "settings": [
        { "type": "text",      "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu",    "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bould — Footer",
      "blocks": [
        { "type": "nav_col", "settings": { "heading": "Company", "menu": "main-menu" } }
      ]
    }
  ]
}
{% endschema %}
