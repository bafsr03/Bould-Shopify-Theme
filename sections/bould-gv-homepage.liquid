{% comment %} ── GHOSTS VINTAGE — Original Vintage Clothing Store (br-fix era) ── {% endcomment %}

<style>
/* ── Reset ── */
.gv-wrap *, .gv-wrap *::before, .gv-wrap *::after { box-sizing: border-box; }
.gv-wrap a { text-decoration: none; }
.gv-wrap img { max-width: 100%; }

/* ── Hide Bould chrome ── */
body:has(.gv-wrap) .header-wrapper,
body:has(.gv-wrap) .shopify-section-group-header-group,
body:has(.gv-wrap) .footer-section,
body:has(.gv-wrap) .shopify-section-group-footer-group,
body:has(.gv-wrap) #shopify-section-announcement-bar,
body:has(.gv-wrap) .bould-cursor { display: none !important; }
body:has(.gv-wrap) #MainContent { padding-top: 0 !important; margin-top: 0 !important; }

/* ── Back bar ── */
.gv-back-bar {
  position: sticky; top: 0; z-index: 9999;
  background: rgba(8,8,8,0.96);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(232,76,43,0.2);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(16px,4vw,40px); height: 48px; gap: 16px;
}
.gv-back-btn {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: .62rem; letter-spacing: .22em; text-transform: uppercase;
  font-weight: 700; color: rgba(245,244,240,.5); transition: color .2s;
  font-family: inherit;
}
.gv-back-btn:hover { color: #E84C2B; }
.gv-back-btn svg { transition: transform .2s; }
.gv-back-btn:hover svg { transform: translateX(-3px); }
.gv-back-badge {
  font-size: .6rem; letter-spacing: .3em; text-transform: uppercase;
  font-weight: 700; color: #E84C2B;
}
.gv-back-actions { display: flex; align-items: center; gap: 16px; }
.gv-back-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .6rem; letter-spacing: .18em; text-transform: uppercase;
  font-weight: 600; color: rgba(245,244,240,.35); transition: color .2s;
  font-family: inherit;
}
.gv-back-link:hover { color: #f5f4f0; }
.gv-back-link--accent { color: rgba(232,76,43,.7); }
.gv-back-link--accent:hover { color: #E84C2B; }

/* ── Header ── */
.gv-header {
  position: absolute; top: 48px; left: 0; right: 0; z-index: 100;
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  padding: 24px clamp(16px,5vw,56px);
}
.gv-header__nav { display: flex; align-items: center; gap: clamp(14px,2.5vw,34px); }
.gv-header__nav--right { justify-content: flex-end; }
.gv-header__link {
  font-size: .6rem; letter-spacing: .22em; text-transform: uppercase;
  font-weight: 600; color: rgba(245,244,240,.65); transition: color .22s;
}
.gv-header__link:hover { color: #E84C2B; }
.gv-header__logo { text-align: center; }
.gv-header__logo img { height: 40px; width: auto; object-fit: contain; }
.gv-header__icons { display: flex; align-items: center; gap: 18px; }
.gv-header__icon-btn {
  color: rgba(245,244,240,.65); transition: color .22s;
  background: none; border: none; cursor: pointer; padding: 0; line-height: 0;
}
.gv-header__icon-btn:hover { color: #E84C2B; }
@media(max-width:749px) {
  .gv-header__nav--left { display: none; }
  .gv-header { grid-template-columns: 1fr auto; }
}

/* ── Hero ── */
.gv-hero {
  position: relative; min-height: 100svh;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden; background: #080808;
}
.gv-hero__bg {
  position: absolute; inset: 0; z-index: 0;
  background: linear-gradient(to bottom,rgba(8,8,8,0.3) 0%,rgba(8,8,8,0.15) 40%,rgba(8,8,8,0.75) 80%,#080808 100%);
}
.gv-hero__bg-img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; z-index: -1; filter: brightness(0.5) saturate(0.65);
}
.gv-hero__body {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  text-align: center; padding: 0 24px;
  animation: gv-body-in 1s cubic-bezier(0,0,0.18,1) 0.3s both;
}
@keyframes gv-body-in {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
.gv-hero__icon {
  width: min(180px,45vw); height: auto; object-fit: contain; margin-bottom: 32px;
  filter: drop-shadow(0 0 40px rgba(232,76,43,0.45));
  animation: gv-float 4s ease-in-out infinite;
}
@keyframes gv-float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}
.gv-hero__eyebrow {
  font-size: .65rem; letter-spacing: .35em; text-transform: uppercase;
  color: rgba(245,244,240,0.5); font-weight: 600; margin: 0 0 16px;
}
.gv-hero__heading {
  font-size: clamp(2.8rem,7.5vw,7rem); font-weight: 800; line-height: .93;
  letter-spacing: -.03em; text-transform: uppercase; color: #f5f4f0; margin: 0 0 40px;
}
.gv-hero__btn {
  display: inline-block; padding: 16px 40px; font-size: .7rem;
  letter-spacing: .2em; text-transform: uppercase; font-weight: 700;
  color: #fff; background: transparent;
  border: 1px solid rgba(245,244,240,0.35); border-radius: 2px;
  transition: background .25s ease, border-color .25s ease, transform .2s ease;
}
.gv-hero__btn:hover { background: #E84C2B; border-color: #E84C2B; transform: translateY(-2px); }
.gv-hero__scroll {
  position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
  z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.gv-hero__scroll span {
  font-size: .58rem; letter-spacing: .25em; text-transform: uppercase;
  color: rgba(245,244,240,0.3);
}
.gv-hero__scroll-line {
  width: 1px; height: 40px;
  background: linear-gradient(to bottom,rgba(245,244,240,0.4),transparent);
  animation: gv-scroll-drop 1.6s ease-in-out infinite;
}
@keyframes gv-scroll-drop {
  0%   { transform: scaleY(0); transform-origin: top; }
  50%  { transform: scaleY(1); transform-origin: top; }
  51%  { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

/* ── Brand Statement ── */
.gv-statement-wrap { background: #080808; padding: 100px 24px; }
.gv-statement { text-align: center; max-width: 1100px; margin: 0 auto; }
.gv-statement__label {
  display: block; font-size: .68rem; letter-spacing: .3em; text-transform: uppercase;
  color: #E84C2B; font-weight: 600; margin-bottom: 28px;
}
.gv-statement__text {
  font-size: clamp(2rem,5.5vw,5rem); font-weight: 800; line-height: 1.06;
  letter-spacing: -.02em; color: #f5f4f0; margin: 0; text-transform: uppercase;
}
.gv-statement__text em {
  font-style: normal; text-decoration: line-through; color: rgba(245,244,240,.45);
}
.gv-statement__sub {
  margin-top: 32px; font-size: .85rem; letter-spacing: .08em;
  color: rgba(245,244,240,.55); text-transform: uppercase;
}

/* ── Three Pillars ── */
.gv-pillars { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; width: 100%; }
.gv-pillar { position: relative; aspect-ratio: 3/4; overflow: hidden; background: #111; }
.gv-pillar__img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .7s cubic-bezier(0,0,.18,1);
  filter: brightness(.55);
}
.gv-pillar:hover .gv-pillar__img { transform: scale(1.06); filter: brightness(.4); }
.gv-pillar__body {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  justify-content: flex-end; padding: 32px 28px;
  background: linear-gradient(to top,rgba(8,8,8,.92) 0%,rgba(8,8,8,.4) 45%,transparent 100%);
}
.gv-pillar__num {
  font-size: .65rem; letter-spacing: .28em; text-transform: uppercase;
  color: #E84C2B; font-weight: 700; margin-bottom: 10px;
}
.gv-pillar__title {
  font-size: 1.6rem; font-weight: 800; text-transform: uppercase;
  color: #f5f4f0; letter-spacing: .02em; margin: 0 0 10px;
}
.gv-pillar__desc {
  font-size: .78rem; line-height: 1.55; color: rgba(245,244,240,.65);
  margin: 0; max-width: 260px;
}

/* ── Newsletter ── */
.gv-newsletter-wrap { background: #080808; padding: 100px 24px; }
.gv-newsletter { text-align: center; max-width: 680px; margin: 0 auto; }
.gv-newsletter__label {
  display: block; font-size: .65rem; letter-spacing: .3em; text-transform: uppercase;
  color: rgba(245,244,240,.5); margin-bottom: 20px;
}
.gv-newsletter__title {
  font-size: clamp(2.2rem,5vw,4rem); font-weight: 800; text-transform: uppercase;
  letter-spacing: -.01em; color: #f5f4f0; margin: 0 0 10px;
}
.gv-newsletter__title span { color: #E84C2B; }
.gv-newsletter__sub {
  font-size: .82rem; color: rgba(245,244,240,.5); letter-spacing: .06em;
  text-transform: uppercase; margin-bottom: 40px;
}
.gv-newsletter__form {
  display: flex; gap: 0; max-width: 480px; margin: 0 auto;
  border: 1px solid rgba(245,244,244,.18); border-radius: 2px; overflow: hidden;
  transition: border-color .25s ease;
}
.gv-newsletter__form:focus-within { border-color: #E84C2B; }
.gv-newsletter__input {
  flex: 1; background: transparent; border: none; color: #f5f4f0;
  font-size: .82rem; letter-spacing: .08em; padding: 16px 20px; outline: none; min-width: 0;
}
.gv-newsletter__input::placeholder { color: rgba(245,244,240,.35); text-transform: uppercase; letter-spacing: .1em; }
.gv-newsletter__btn {
  background: #E84C2B; color: #fff; border: none; font-size: .68rem;
  letter-spacing: .18em; text-transform: uppercase; font-weight: 700;
  padding: 16px 24px; cursor: pointer; transition: background .2s ease; white-space: nowrap;
}
.gv-newsletter__btn:hover { background: #c73d21; }
.gv-divider-line { width: 80px; height: 2px; background: #E84C2B; margin: 0 auto 40px; display: block; border-radius: 1px; }

/* ── Service CTA ── */
.gv-service { text-align: center; position: relative; overflow: hidden; }
.gv-service__bg {
  position: absolute; inset: 0;
  background: url('https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=1400&q=80') center/cover no-repeat;
  filter: brightness(.25); z-index: 0;
}
.gv-service__inner { position: relative; z-index: 1; max-width: 800px; margin: 0 auto; padding: 100px 24px; }
.gv-service__label {
  display: block; font-size: .65rem; letter-spacing: .3em; text-transform: uppercase;
  color: rgba(245,244,240,.5); margin-bottom: 20px;
}
.gv-service__title {
  font-size: clamp(2.8rem,7vw,6rem); font-weight: 800; text-transform: uppercase;
  letter-spacing: -.02em; color: #f5f4f0; margin: 0 0 20px; line-height: 1;
}
.gv-service__desc {
  font-size: .88rem; line-height: 1.7; color: rgba(245,244,240,.6);
  margin: 0 0 44px; max-width: 500px; margin-left: auto; margin-right: auto;
}
.gv-service__btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.gv-service__btn {
  display: inline-block; padding: 14px 32px; font-size: .72rem; letter-spacing: .18em;
  text-transform: uppercase; font-weight: 700; border-radius: 2px; transition: all .25s ease;
}
.gv-service__btn--primary { background: #E84C2B; color: #fff; border: 1px solid #E84C2B; }
.gv-service__btn--primary:hover { background: #c73d21; border-color: #c73d21; transform: translateY(-2px); }
.gv-service__btn--secondary { background: transparent; color: #f5f4f0; border: 1px solid rgba(245,244,240,.3); }
.gv-service__btn--secondary:hover { background: rgba(245,244,240,.08); border-color: rgba(245,244,240,.5); transform: translateY(-2px); }

/* ── Footer ── */
.gv-footer {
  background: #080808; border-top: 1px solid rgba(232,76,43,0.12);
  padding: 56px clamp(16px,5vw,56px) 40px;
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px;
}
.gv-footer__logo img { height: 36px; width: auto; object-fit: contain; }
.gv-footer__nav { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; }
.gv-footer__nav a {
  font-size: .58rem; letter-spacing: .22em; text-transform: uppercase;
  color: rgba(245,244,240,.3); font-weight: 600; transition: color .2s;
}
.gv-footer__nav a:hover { color: #E84C2B; }
.gv-footer__copy {
  font-size: .58rem; letter-spacing: .12em; text-transform: uppercase;
  color: rgba(245,244,240,.2); text-align: right; line-height: 1.6;
}

/* ── Responsive ── */
@media(max-width:749px) {
  .gv-pillars { grid-template-columns: 1fr; }
  .gv-hero__heading { font-size: clamp(2.2rem,10vw,3.8rem); }
  .gv-hero__icon { width: min(120px,40vw); }
  .gv-footer { grid-template-columns: 1fr; text-align: center; }
  .gv-footer__copy { text-align: center; }
}
</style>

<div class="gv-wrap" style="background:#080808;font-family:'Inter',sans-serif;color:#f5f4f0">

  {%- comment -%} ── BACK BAR ── {%- endcomment -%}
  <div class="gv-back-bar">
    <a href="{{ section.settings.back_url | default: '/pages/build' }}" class="gv-back-btn">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M11 7H3M3 7L7 3M3 7L7 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      {{ section.settings.back_label | default: 'Back to Build' }}
    </a>
    <span class="gv-back-badge">Ghosts Vintage — Original Era</span>
    <div class="gv-back-actions">
      {%- if section.settings.next_version_url != blank -%}
        <a href="{{ section.settings.next_version_url }}" class="gv-back-link gv-back-link--accent">
          Next Version &rarr;
        </a>
      {%- endif -%}
      <a href="https://ghost-vintage-6371.myshopify.com" target="_blank" rel="noopener noreferrer" class="gv-back-link">
        Live Store
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path d="M1 9L9 1M9 1H3.5M9 1V6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  {%- comment -%} ── HEADER ── {%- endcomment -%}
  <header class="gv-header">
    <nav class="gv-header__nav gv-header__nav--left">
      <a href="#" class="gv-header__link">Clothing</a>
      <a href="#" class="gv-header__link">Decor</a>
      <a href="#" class="gv-header__link">Accessories</a>
    </nav>
    <div class="gv-header__logo">
      <img src="{{ 'gv-favicon.png' | asset_url }}" alt="Ghosts Vintage" width="44" height="44" loading="eager">
    </div>
    <nav class="gv-header__nav gv-header__nav--right">
      <a href="#" class="gv-header__link">About</a>
      <div class="gv-header__icons">
        <button class="gv-header__icon-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="7.5" cy="7.5" r="5" stroke="currentColor" stroke-width="1.4"/><path d="M11.5 11.5L15.5 15.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </button>
        <button class="gv-header__icon-btn" aria-label="Cart">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 2h2l2 8h7l2-6H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8" cy="14" r="1" fill="currentColor"/><circle cx="13" cy="14" r="1" fill="currentColor"/></svg>
        </button>
      </div>
    </nav>
  </header>

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <div class="gv-hero">
    <div class="gv-hero__bg">
      <img src="{{ 'gv-heroimg.png' | asset_url }}" alt="" class="gv-hero__bg-img" loading="eager" fetchpriority="high">
    </div>
    <div class="gv-hero__body">
      <img src="{{ 'gv-logo.png' | asset_url }}" alt="Ghosts Vintage" class="gv-hero__icon" width="320" height="320" loading="eager">
      <p class="gv-hero__eyebrow">New Arrivals</p>
      <h1 class="gv-hero__heading">Vintage clothing,<br>decor, &amp; more!</h1>
      <a href="#" class="gv-hero__btn">Shop the Collection</a>
    </div>
    <div class="gv-hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="gv-hero__scroll-line"></div>
    </div>
  </div>

  {%- comment -%} ── BRAND STATEMENT ── {%- endcomment -%}
  <div class="gv-statement-wrap">
    <div class="gv-statement">
      <span class="gv-statement__label">Our Obsession</span>
      <p class="gv-statement__text">
        TO HUNT DOWN THE <em>RAREST</em>,<br>
        MOST ICONIC PIECES AND<br>
        GIVE THEM A <em>SECOND</em> LIFE.<br>
        THIS IS VINTAGE DONE <em>RIGHT</em>.
      </p>
      <p class="gv-statement__sub">Ghosts Vintage &mdash; Est. Seattle</p>
    </div>
  </div>

  {%- comment -%} ── THREE PILLARS ── {%- endcomment -%}
  <div class="gv-pillars">
    <div class="gv-pillar">
      <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80" alt="The Hunt" class="gv-pillar__img" loading="lazy">
      <div class="gv-pillar__body">
        <span class="gv-pillar__num">01</span>
        <h3 class="gv-pillar__title">The Hunt</h3>
        <p class="gv-pillar__desc">We scour estate sales, markets and closets across the country for the pieces worth saving.</p>
      </div>
    </div>
    <div class="gv-pillar">
      <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?w=600&q=80" alt="The Find" class="gv-pillar__img" loading="lazy">
      <div class="gv-pillar__body">
        <span class="gv-pillar__num">02</span>
        <h3 class="gv-pillar__title">The Find</h3>
        <p class="gv-pillar__desc">Every item is hand-selected, authenticated and restored to its original glory — or better.</p>
      </div>
    </div>
    <div class="gv-pillar">
      <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?w=600&q=80" alt="The Haunt" class="gv-pillar__img" loading="lazy">
      <div class="gv-pillar__body">
        <span class="gv-pillar__num">03</span>
        <h3 class="gv-pillar__title">The Haunt</h3>
        <p class="gv-pillar__desc">Your wardrobe becomes a curated archive. One-of-a-kind pieces, worn by legends, now yours.</p>
      </div>
    </div>
  </div>

  {%- comment -%} ── NEWSLETTER ── {%- endcomment -%}
  <div class="gv-newsletter-wrap">
    <div class="gv-newsletter">
      <span class="gv-newsletter__label">Stay in the loop</span>
      <h2 class="gv-newsletter__title">JOIN THE <span>HAUNT</span></h2>
      <p class="gv-newsletter__sub">New drops. Rare finds. First access.</p>
      <span class="gv-divider-line"></span>
      <form class="gv-newsletter__form" action="#" method="post">
        <input class="gv-newsletter__input" type="email" placeholder="Your email address" required>
        <button class="gv-newsletter__btn" type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  {%- comment -%} ── SERVICE CTA ── {%- endcomment -%}
  <div class="gv-service">
    <div class="gv-service__bg"></div>
    <div class="gv-service__inner">
      <span class="gv-service__label">Need something special?</span>
      <h2 class="gv-service__title">AT YOUR<br>SERVICE</h2>
      <p class="gv-service__desc">Personal styling. Custom sourcing. Private appointments. Whatever you need — we make vintage work for you.</p>
      <div class="gv-service__btns">
        <a href="#" class="gv-service__btn gv-service__btn--primary">Contact Us</a>
        <a href="#" class="gv-service__btn gv-service__btn--secondary">Shop Now</a>
      </div>
    </div>
  </div>

  {%- comment -%} ── FOOTER ── {%- endcomment -%}
  <footer class="gv-footer">
    <nav class="gv-footer__nav">
      <a href="#">Clothing</a>
      <a href="#">Decor</a>
      <a href="#">Accessories</a>
      <a href="#">About</a>
    </nav>
    <div class="gv-footer__logo">
      <img src="{{ 'gv-favicon.png' | asset_url }}" alt="Ghosts Vintage" width="40" height="40" loading="lazy">
    </div>
    <p class="gv-footer__copy">&copy; {{ 'now' | date: '%Y' }} Ghosts Vintage<br>Seattle, WA</p>
  </footer>

</div>

{% schema %}
{
  "name": "Ghosts Vintage — Original",
  "tag": "div",
  "class": "gv-section-wrap",
  "settings": [
    { "type": "url",  "id": "back_url",          "label": "Back button URL" },
    { "type": "text", "id": "back_label",         "label": "Back button label",      "default": "Back to Build" },
    { "type": "url",  "id": "next_version_url",   "label": "Next version URL",       "info": "Links forward to the Charlie Pike Tobacco evolution of this project." }
  ],
  "presets": [{ "name": "Ghosts Vintage — Original" }]
}
{% endschema %}
