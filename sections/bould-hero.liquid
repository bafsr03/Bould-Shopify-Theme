<section class="bould-hero" id="bould-hero">
  {% comment %} Background grid {% endcomment %}
  <div class="bould-hero__bg-grid" aria-hidden="true"></div>

  {% comment %} Three.js canvas — 3 GLB models morph between each other on click {% endcomment %}
  <canvas
    id="bould-hero-canvas"
    class="bould-hero__canvas"
    aria-label="Interactive 3D particle morpher — click to cycle between shapes"
    data-model-1="{% if section.settings.obj_url_1 != blank %}{{ section.settings.obj_url_1 }}{% else %}{{ 'bbould.obj' | asset_url }}{% endif %}"
    data-model-2="{{ section.settings.obj_url_2 }}"
    data-model-3="{{ section.settings.obj_url_3 }}"
  ></canvas>

  {% comment %} Interaction hint — fades in after 4 s, dismissed on first click {% endcomment %}
  <div class="bould-hero__interact-hint" id="bould-interact-hint" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
      <path d="M7 12h10M12 7l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>Click to morph</span>
  </div>

  {% comment %} Text content {% endcomment %}
  <div class="bould-hero__content">
    <span class="bould-hero__eyebrow">
      {{- section.settings.eyebrow | default: 'Retail Technology Company' -}}
    </span>

    <h1 class="bould-hero__headline">
      <span class="line">
        <span class="line-inner">{{ section.settings.headline_line1 | default: 'We Build' }}</span>
      </span>
      <span class="line">
        <span class="line-inner">{{ section.settings.headline_line2 | default: 'The Future' }}</span>
      </span>
      <span class="line line--accent">
        <span class="line-inner">{{ section.settings.headline_line3 | default: 'Of Commerce.' }}</span>
      </span>
    </h1>

    <p class="bould-hero__body">
      {{- section.settings.body | default: 'High-performance Shopify stores. Immersive 3D experiences. Virtual try-on technology. End-to-end digital commerce for brands that refuse to settle.' -}}
    </p>

    <div class="bould-hero__actions">
      <a href="{{ section.settings.cta_primary_url | default: '#contact' }}" class="bould-btn bould-btn--primary">
        {{- section.settings.cta_primary | default: 'Start a Project' -}}
      </a>
      <a href="{{ section.settings.cta_secondary_url | default: '#work' }}" class="bould-btn bould-btn--ghost">
        {{- section.settings.cta_secondary | default: 'View Our Work' -}}
        <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  {% comment %} Scroll indicator {% endcomment %}
  <div class="bould-hero__scroll" aria-hidden="true">
    <div class="bould-hero__scroll-line"></div>
    <span>Scroll</span>
  </div>

  {% comment %} Quick stats bottom-right {% endcomment %}
  <div class="bould-hero__stats" aria-hidden="true">
    {% for block in section.blocks %}
      {% if block.type == 'stat' %}
        <div class="bould-hero__stat">
          <span class="bould-hero__stat-num">{{ block.settings.number }}</span>
          <span class="bould-hero__stat-label">{{ block.settings.label }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% comment %} Sticky header class on scroll {% endcomment %}
<script>
(function() {
  var hw = document.querySelector('.header-wrapper');
  if (!hw) return;
  window.addEventListener('scroll', function() {
    hw.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });
})();

/* Dismiss the "Click to morph" hint on first real interact (not drag) */
(function() {
  var hint   = document.getElementById('bould-interact-hint');
  var canvas = document.getElementById('bould-hero-canvas');
  if (!hint || !canvas) return;

  var downX = 0;
  var DRAG_THRESHOLD = 5; // px — same as DRAG_PX in bould-scene.js

  canvas.addEventListener('mousedown',  function(e) { downX = e.clientX; });
  canvas.addEventListener('touchstart', function(e) {
    if (e.touches.length) downX = e.touches[0].clientX;
  }, { passive: true });

  function onUp(e) {
    var upX = e.changedTouches
      ? (e.changedTouches[0] && e.changedTouches[0].clientX)
      : e.clientX;
    /* Ignore drags — only react to true taps/clicks */
    if (Math.abs((upX || downX) - downX) > DRAG_THRESHOLD) return;

    /* Permanently dismiss the badge after first real interaction */
    hint.classList.add('is-hidden');
    window.removeEventListener('mouseup', onUp);
    canvas.removeEventListener('touchend', onUp);
  }

  window.addEventListener('mouseup', onUp);
  canvas.addEventListener('touchend', onUp, { passive: true });
})();
</script>

{% comment %} Three.js scene (ES module) {% endcomment %}
<script type="module" src="{{ 'bould-scene.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Bould — Hero",
  "tag": "div",
  "class": "bould-page-wrap",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Retail Technology Company"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline — line 1",
      "default": "We Build"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline — line 2",
      "default": "The Future"
    },
    {
      "type": "text",
      "id": "headline_line3",
      "label": "Headline — line 3 (accent color)",
      "default": "Of Commerce."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "High-performance Shopify stores. Immersive 3D experiences. Virtual try-on technology. End-to-end digital commerce for brands that refuse to settle."
    },
    {
      "type": "text",
      "id": "cta_primary",
      "label": "Primary CTA label",
      "default": "Start a Project"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary",
      "label": "Secondary CTA label",
      "default": "View Our Work"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "text",
      "id": "obj_url_1",
      "label": "3D Model 1 URL (.glb / .obj) — Shape A",
      "info": "Upload to Shopify Admin → Content → Files. Copy the CDN URL. This is the first shape in the morph cycle."
    },
    {
      "type": "text",
      "id": "obj_url_2",
      "label": "3D Model 2 URL (.glb / .obj) — Shape B",
      "info": "Second shape in the cycle. Leave blank to use a fallback 'B' character."
    },
    {
      "type": "text",
      "id": "obj_url_3",
      "label": "3D Model 3 URL (.glb / .obj) — Shape C",
      "info": "Third shape in the cycle. Leave blank to use a fallback 'U' character."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Hero stat",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "3+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Brands Launched"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bould — Hero",
      "blocks": [
        { "type": "stat", "settings": { "number": "5+", "label": "Brands Launched" } },
        { "type": "stat", "settings": { "number": "300%", "label": "Avg Revenue Growth" } },
        { "type": "stat", "settings": { "number": "3D", "label": "Commerce Pioneers" } }
      ]
    }
  ]
}
{% endschema %}
