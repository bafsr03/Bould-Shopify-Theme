{%- liquid
  assign eyebrow     = section.settings.eyebrow       | default: 'Build'
  assign title1      = section.settings.title_line1   | default: 'Everything your'
  assign title2      = section.settings.title_line2   | default: 'store needs to win.'
  assign intro       = section.settings.intro         | default: 'From immersive 3D storefronts to virtual try-on and conversion-tuned Shopify builds — we cover every layer of the commerce stack.'
  assign proc_label  = section.settings.process_label | default: 'The Process'
  assign proc_t1     = section.settings.process_title  | default: 'How we bring'
  assign proc_t2     = section.settings.process_title2 | default: 'projects to life.'
  assign cta_label   = section.settings.cta_label     | default: "Let's build something."
  assign cta_btn     = section.settings.cta_btn       | default: 'Start a Project'

  assign services     = section.blocks | where: 'type', 'service'
  assign steps        = section.blocks | where: 'type', 'step'
  assign theme_cards  = section.blocks | where: 'type', 'theme_card'
-%}

{%- comment -%} ── PAGE HERO ── {%- endcomment -%}
<div class="bould-page-hero">
  <div class="bould-hero__bg-grid" aria-hidden="true"></div>
  <span class="bould-page-hero__ghost" aria-hidden="true">{{ eyebrow | upcase }}</span>
  <div class="bould-page-hero__inner">
    <p class="bould-section-label bould-reveal">{{ eyebrow }}</p>
    <h1 class="bould-page-hero__title">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ title1 }}</span></span>
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner bould-accent">{{ title2 }}</span></span>
    </h1>
    <p class="bould-page-hero__sub bould-reveal">{{ intro }}</p>
    <div class="bould-page-hero__scroll bould-reveal" aria-hidden="true">
      <div class="bould-hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
</div>

{%- comment -%} ── SERVICES ── {%- endcomment -%}
<div class="bould-build-services">
  <ul class="bould-services__list" role="list">
    {%- for block in services -%}
      <li class="bould-service-item bould-reveal" {{ block.shopify_attributes }}>
        <span class="bould-service-item__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <div class="bould-service-item__content">
          <span class="bould-service-item__name">{{ block.settings.name }}</span>
          {%- if block.settings.description != blank -%}
            <p class="bould-service-item__desc">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.tags != blank -%}
            <div class="bould-service-item__tags">
              {%- assign tag_list = block.settings.tags | split: ',' -%}
              {%- for tag in tag_list -%}
                <span class="bould-tag">{{ tag | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        <div class="bould-service-item__arrow" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{%- comment -%} ── PROCESS ── {%- endcomment -%}
{%- if steps.size > 0 -%}
<div class="bould-build-process">
  <div class="bould-section-header">
    <div>
      <p class="bould-section-label bould-reveal">{{ proc_label }}</p>
      <h2 class="bould-section-title">
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ proc_t1 }}</span></span>
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ proc_t2 }}</span></span>
      </h2>
    </div>
  </div>
  <ol class="bould-process" role="list">
    {%- for block in steps -%}
      <li class="bould-process__step bould-reveal" {{ block.shopify_attributes }}>
        <span class="bould-process__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <h3 class="bould-process__name">{{ block.settings.name }}</h3>
        <p class="bould-process__desc">{{ block.settings.description }}</p>
      </li>
    {%- endfor -%}
  </ol>
</div>
{%- endif -%}

{%- comment -%} ── PRE-BUILT THEMES ── {%- endcomment -%}
{%- if theme_cards.size > 0 -%}
<div class="bould-build-portfolio">
  <div class="bould-section-header">
    <div>
      <p class="bould-section-label bould-reveal">{{ section.settings.portfolio_label | default: 'Pre-built Themes' }}</p>
      <h2 class="bould-section-title">
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ section.settings.portfolio_title1 | default: 'Ready to launch' }}</span></span>
        <span class="bould-line-reveal"><span class="bould-line-reveal-inner bould-accent">{{ section.settings.portfolio_title2 | default: 'themes & stores.' }}</span></span>
      </h2>
    </div>
  </div>
  <div class="bould-theme-grid">
    {%- for block in theme_cards -%}
      {%- assign card_url = block.settings.preview_url | default: '#' -%}
      <div class="bould-theme-card bould-reveal" {{ block.shopify_attributes }}>
        <a href="{{ card_url }}" class="bould-theme-card__preview" aria-label="Preview {{ block.settings.name }}">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}"
                 alt="{{ block.settings.name }} theme preview"
                 loading="lazy"
                 width="900"
                 class="bould-theme-card__img">
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}"
                 alt="{{ block.settings.name }} theme preview"
                 loading="lazy"
                 class="bould-theme-card__img">
          {%- else -%}
            <div class="bould-theme-card__placeholder">
              <span>{{ block.settings.name | slice: 0, 1 | upcase }}</span>
            </div>
          {%- endif -%}
          <div class="bould-theme-card__overlay" aria-hidden="true">
            <span class="bould-theme-card__preview-label">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              View Theme
            </span>
          </div>
        </a>
        <div class="bould-theme-card__body">
          <div class="bould-theme-card__meta">
            <h3 class="bould-theme-card__name">{{ block.settings.name }}</h3>
            {%- if block.settings.badge != blank -%}
              <span class="bould-theme-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.description != blank -%}
            <p class="bould-theme-card__desc">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.tags != blank -%}
            <div class="bould-theme-card__tags">
              {%- assign tag_list = block.settings.tags | split: ',' -%}
              {%- for tag in tag_list -%}
                <span class="bould-tag">{{ tag | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <a href="{{ card_url }}" class="bould-btn bould-btn--ghost bould-btn--sm">
            View Theme
            <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- comment -%} ── CTA ── {%- endcomment -%}
<div class="bould-page-cta">
  <div class="bould-page-cta__inner">
    <h2 class="bould-page-cta__label">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ cta_label }}</span></span>
    </h2>
    <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="bould-btn bould-btn--primary bould-page-cta__btn bould-reveal">
      {{ cta_btn }}
      <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Bould — Build",
  "tag": "div",
  "class": "bould-page-wrap",
  "settings": [
    { "type": "text",    "id": "eyebrow",        "label": "Eyebrow",              "default": "Build" },
    { "type": "text",    "id": "title_line1",    "label": "Title line 1",         "default": "Everything your" },
    { "type": "text",    "id": "title_line2",    "label": "Title line 2",         "default": "store needs to win." },
    { "type": "textarea","id": "intro",          "label": "Intro paragraph",      "default": "From immersive 3D storefronts to virtual try-on and conversion-tuned Shopify builds — we cover every layer of the commerce stack." },
    { "type": "text",    "id": "process_label",  "label": "Process section label","default": "The Process" },
    { "type": "text",    "id": "process_title",  "label": "Process title line 1", "default": "How we bring" },
    { "type": "text",    "id": "process_title2", "label": "Process title line 2", "default": "projects to life." },
    { "type": "text",    "id": "cta_label",      "label": "CTA heading",          "default": "Let's build something." },
    { "type": "url",     "id": "cta_url",        "label": "CTA link" },
    { "type": "text",    "id": "cta_btn",        "label": "CTA button text",      "default": "Start a Project" },
    { "type": "header",  "content": "Pre-built Themes Section" },
    { "type": "text",    "id": "portfolio_label",  "label": "Section eyebrow",    "default": "Pre-built Themes" },
    { "type": "text",    "id": "portfolio_title1", "label": "Title line 1",       "default": "Ready to launch" },
    { "type": "text",    "id": "portfolio_title2", "label": "Title line 2",       "default": "themes & stores." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text",     "id": "name",        "label": "Service name" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text",     "id": "tags",        "label": "Tags (comma-separated)" }
      ]
    },
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        { "type": "text",     "id": "name",        "label": "Step name" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "theme_card",
      "name": "Theme Card",
      "settings": [
        { "type": "text",         "id": "name",          "label": "Theme name",                         "default": "Theme Name" },
        { "type": "text",         "id": "badge",         "label": "Badge (e.g. New, Featured)" },
        { "type": "textarea",     "id": "description",   "label": "Short description" },
        { "type": "text",         "id": "tags",          "label": "Tags (comma-separated)" },
        { "type": "image_picker", "id": "image",         "label": "Preview screenshot (Shopify Media)" },
        { "type": "text",         "id": "asset_image",   "label": "Preview image filename (Assets folder)" },
        { "type": "url",          "id": "preview_url",   "label": "Preview page URL (internal)" },
        { "type": "url",          "id": "store_url",     "label": "Live store URL (external)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bould — Build",
      "blocks": [
        { "type": "service", "settings": { "name": "3D Storefronts", "description": "Immersive, interactive 3D product experiences built directly into your Shopify store. Let customers explore every detail before they buy.", "tags": "Three.js, WebGL, Shopify" } },
        { "type": "service", "settings": { "name": "Virtual Try-On", "description": "AR-powered try-on technology that drops products into the real world — dramatically reducing returns and boosting confidence at checkout.", "tags": "AR, Computer Vision, Mobile" } },
        { "type": "service", "settings": { "name": "Shopify Development", "description": "Conversion-tuned Shopify stores built from scratch or redesigned for performance. Custom themes, apps, and integrations.", "tags": "Shopify, Liquid, Performance" } },
        { "type": "service", "settings": { "name": "eCommerce Strategy", "description": "From positioning to post-purchase flows — we design the full customer journey with retention and lifetime value in mind.", "tags": "Strategy, CRO, Analytics" } },
        { "type": "step", "settings": { "name": "Discovery", "description": "We dig into your brand, customers, and competitive landscape. Every project starts with a clear brief and a shared vision." } },
        { "type": "step", "settings": { "name": "Design", "description": "High-fidelity prototypes, 3D asset pipelines, and experience design — all reviewed before a single line of production code." } },
        { "type": "step", "settings": { "name": "Build", "description": "We develop, test, and optimise in tight sprints. Transparent progress, no surprises, shipped on time." } },
        { "type": "step", "settings": { "name": "Launch & Grow", "description": "Post-launch support, analytics review, and continuous improvement. We stay in the picture after go-live." } }
      ]
    }
  ]
}
{% endschema %}
