{%- liquid
  assign eyebrow     = section.settings.eyebrow     | default: 'Studio'
  assign title1      = section.settings.title_line1 | default: 'We make brands'
  assign title2      = section.settings.title_line2 | default: 'impossible to ignore.'
  assign intro       = section.settings.intro       | default: 'Bould is a retail technology studio. We build 3D storefronts, virtual try-on experiences, and high-performance eCommerce — for brands that demand more.'
  assign miss_label  = section.settings.mission_label | default: 'Our Mission'
  assign miss_text   = section.settings.mission_text  | default: 'Commerce is changing — and most brands are being left behind. We exist to close that gap. Bould partners with forward-thinking brands to design and build digital experiences that convert, retain, and inspire.'
  assign vals_label  = section.settings.values_label  | default: 'How We Work'
  assign cta_label   = section.settings.cta_label     | default: 'Ready to build?'
  assign cta_btn     = section.settings.cta_btn       | default: 'Start a Project'
-%}

{%- comment -%} ── PAGE HERO ── {%- endcomment -%}
<div class="bould-page-hero">
  <div class="bould-hero__bg-grid" aria-hidden="true"></div>
  <span class="bould-page-hero__ghost" aria-hidden="true">{{ eyebrow | upcase }}</span>
  <div class="bould-page-hero__inner">
    <p class="bould-section-label bould-reveal">{{ eyebrow }}</p>
    <h1 class="bould-page-hero__title">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ title1 }}</span></span>
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner bould-accent">{{ title2 }}</span></span>
    </h1>
    <p class="bould-page-hero__sub bould-reveal">{{ intro }}</p>
    <div class="bould-page-hero__scroll bould-reveal" aria-hidden="true">
      <div class="bould-hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
</div>

{%- comment -%} ── MISSION ── {%- endcomment -%}
<div class="bould-studio-mission">
  <p class="bould-section-label bould-reveal">{{ miss_label }}</p>
  <blockquote class="bould-studio-mission__quote">
    <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ miss_text }}</span></span>
  </blockquote>
</div>

{%- comment -%} ── VALUES ── {%- endcomment -%}
<div class="bould-studio-values">
  <div class="bould-studio-values__header">
    <p class="bould-section-label bould-reveal">{{ vals_label }}</p>
  </div>
  <ul class="bould-studio-values__list" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'value' -%}
        <li class="bould-studio-value bould-reveal" {{ block.shopify_attributes }}>
          <span class="bould-studio-value__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="bould-studio-value__body">
            <h3 class="bould-studio-value__name">{{ block.settings.name }}</h3>
            <p class="bould-studio-value__desc">{{ block.settings.description }}</p>
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{%- comment -%} ── CTA ── {%- endcomment -%}
<div class="bould-page-cta">
  <div class="bould-page-cta__inner">
    <h2 class="bould-page-cta__label">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ cta_label }}</span></span>
    </h2>
    <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="bould-btn bould-btn--primary bould-page-cta__btn bould-reveal">
      {{ cta_btn }}
      <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Bould — Studio",
  "tag": "div",
  "class": "bould-page-wrap",
  "settings": [
    { "type": "text",    "id": "eyebrow",       "label": "Eyebrow",         "default": "Studio" },
    { "type": "text",    "id": "title_line1",   "label": "Title line 1",    "default": "We make brands" },
    { "type": "text",    "id": "title_line2",   "label": "Title line 2",    "default": "impossible to ignore." },
    { "type": "textarea","id": "intro",         "label": "Intro paragraph", "default": "Bould is a retail technology studio. We build 3D storefronts, virtual try-on experiences, and high-performance eCommerce — for brands that demand more." },
    { "type": "text",    "id": "mission_label", "label": "Mission label",   "default": "Our Mission" },
    { "type": "textarea","id": "mission_text",  "label": "Mission statement","default": "Commerce is changing — and most brands are being left behind. We exist to close that gap. Bould partners with forward-thinking brands to design and build digital experiences that convert, retain, and inspire." },
    { "type": "text",    "id": "values_label",  "label": "Values label",    "default": "How We Work" },
    { "type": "text",    "id": "cta_label",     "label": "CTA heading",     "default": "Ready to build?" },
    { "type": "url",     "id": "cta_url",       "label": "CTA link" },
    { "type": "text",    "id": "cta_btn",       "label": "CTA button text", "default": "Start a Project" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text",     "id": "name",        "label": "Name" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bould — Studio",
      "blocks": [
        { "type": "value", "settings": { "name": "Bold by default", "description": "We don't do safe. Every project we take on gets our full creative and technical attention — the kind that leaves a mark." } },
        { "type": "value", "settings": { "name": "Technology first", "description": "3D, AR, try-on, real-time rendering — we build at the edge of what's possible in commerce today." } },
        { "type": "value", "settings": { "name": "Results-obsessed", "description": "Great design means nothing without conversion. We measure everything and iterate until the numbers move." } }
      ]
    }
  ]
}
{% endschema %}
