{%- liquid
  assign eyebrow   = section.settings.eyebrow    | default: 'Work'
  assign title1    = section.settings.title_line1 | default: 'Projects that'
  assign title2    = section.settings.title_line2 | default: 'move the needle.'
  assign intro     = section.settings.intro       | default: 'A growing portfolio of brands we have helped design, build, and scale — from first launch to full acceleration.'
  assign cta_label = section.settings.cta_label  | default: 'Your brand could be next.'
  assign cta_btn   = section.settings.cta_btn    | default: 'Start a Project'
  assign projects  = section.blocks | where: 'type', 'project'
-%}

{%- comment -%} ── PAGE HERO ── {%- endcomment -%}
<div class="bould-page-hero">
  <div class="bould-hero__bg-grid" aria-hidden="true"></div>
  <span class="bould-page-hero__ghost" aria-hidden="true">{{ eyebrow | upcase }}</span>
  <div class="bould-page-hero__inner">
    <p class="bould-section-label bould-reveal">{{ eyebrow }}</p>
    <h1 class="bould-page-hero__title">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ title1 }}</span></span>
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner bould-accent">{{ title2 }}</span></span>
    </h1>
    <p class="bould-page-hero__sub bould-reveal">{{ intro }}</p>
    <div class="bould-page-hero__scroll bould-reveal" aria-hidden="true">
      <div class="bould-hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
</div>

{%- comment -%} ── PROJECT GRID ── {%- endcomment -%}
<div class="bould-work bould-work--page" id="work-grid">
  {%- if projects.size > 0 -%}
    <div class="bould-work__grid">
      {%- for block in projects -%}
        {%- assign card_idx = forloop.index0 | modulo: 6 -%}
        {%- if card_idx == 0 -%}{%- assign bg_g = 'linear-gradient(135deg,#1A1A2E 0%,#0D1B42 100%)' -%}
        {%- elsif card_idx == 1 -%}{%- assign bg_g = 'linear-gradient(135deg,#0D1117 0%,#1C2B1A 100%)' -%}
        {%- elsif card_idx == 2 -%}{%- assign bg_g = 'linear-gradient(135deg,#1C1C1E 0%,#2D1A0E 100%)' -%}
        {%- elsif card_idx == 3 -%}{%- assign bg_g = 'linear-gradient(135deg,#0A1628 0%,#1A0A28 100%)' -%}
        {%- elsif card_idx == 4 -%}{%- assign bg_g = 'linear-gradient(135deg,#12181B 0%,#0A2018 100%)' -%}
        {%- else -%}{%- assign bg_g = 'linear-gradient(135deg,#1A0A0A 0%,#2A1818 100%)' -%}
        {%- endif -%}
        <article
          class="bould-work-card bould-reveal"
          {{ block.shopify_attributes }}
          {% if block.settings.url != blank %}onclick="window.location='{{ block.settings.url }}'" role="link" tabindex="0"{% endif %}
        >
          <div class="bould-work-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;transition:transform 0.7s cubic-bezier(0.16,1,0.3,1)' }}
            {%- else -%}
              <div class="bould-work-card__bg" style="background:{{ bg_g }};"></div>
            {%- endif -%}
          </div>
          <div class="bould-work-card__body">
            <div class="bould-work-card__meta">
              {%- if block.settings.type != blank -%}<span class="bould-work-card__type">{{ block.settings.type }}</span>{%- endif -%}
              {%- if block.settings.year != blank -%}<span class="bould-work-card__year">{{ block.settings.year }}</span>{%- endif -%}
            </div>
            <h2 class="bould-work-card__title">{{ block.settings.title }}</h2>
            {%- if block.settings.result != blank -%}
              <p class="bould-work-card__result">{{ block.settings.result }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

  {%- else -%}
    <div class="bould-work-empty">
      <div class="bould-work-empty__inner bould-reveal">
        <span class="bould-work-empty__num" aria-hidden="true">—</span>
        <p class="bould-section-label">Coming soon</p>
        <p class="bould-work-empty__text">We are currently heads-down on our first client launches. Case studies dropping soon.</p>
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%} ── CTA ── {%- endcomment -%}
<div class="bould-page-cta">
  <div class="bould-page-cta__inner">
    <h2 class="bould-page-cta__label">
      <span class="bould-line-reveal"><span class="bould-line-reveal-inner">{{ cta_label }}</span></span>
    </h2>
    <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="bould-btn bould-btn--primary bould-page-cta__btn bould-reveal">
      {{ cta_btn }}
      <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Bould — Work",
  "tag": "div",
  "class": "bould-page-wrap",
  "settings": [
    { "type": "text",    "id": "eyebrow",    "label": "Eyebrow",       "default": "Work" },
    { "type": "text",    "id": "title_line1","label": "Title line 1",  "default": "Projects that" },
    { "type": "text",    "id": "title_line2","label": "Title line 2",  "default": "move the needle." },
    { "type": "textarea","id": "intro",      "label": "Intro paragraph","default": "A growing portfolio of brands we have helped design, build, and scale — from first launch to full acceleration." },
    { "type": "text",    "id": "cta_label",  "label": "CTA heading",   "default": "Your brand could be next." },
    { "type": "url",     "id": "cta_url",    "label": "CTA link" },
    { "type": "text",    "id": "cta_btn",    "label": "CTA button",    "default": "Start a Project" }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "text",         "id": "title",  "label": "Brand / project name" },
        { "type": "text",         "id": "type",   "label": "Type" },
        { "type": "text",         "id": "year",   "label": "Year" },
        { "type": "text",         "id": "result", "label": "Key result" },
        { "type": "image_picker", "id": "image",  "label": "Cover image" },
        { "type": "url",          "id": "url",    "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Bould — Work" }]
}
{% endschema %}
