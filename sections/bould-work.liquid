<section class="bould-work" id="work" aria-label="Selected Work">
  <div class="bould-section-header">
    <div>
      <p class="bould-section-label bould-reveal">{{ section.settings.label | default: 'Selected Work' }}</p>
      <h2 class="bould-section-title">
        <span class="bould-line-reveal">
          <span class="bould-line-reveal-inner">{{ section.settings.title_line1 | default: "Brands we've" }}</span>
        </span>
        <span class="bould-line-reveal">
          <span class="bould-line-reveal-inner">{{ section.settings.title_line2 | default: 'helped grow.' }}</span>
        </span>
      </h2>
    </div>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="bould-btn bould-btn--ghost bould-reveal">
        {{ section.settings.cta_label }}
        <svg class="bould-btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="bould-work__grid" aria-label="Case studies">
    {% for block in section.blocks %}
      <article
        class="bould-work-card"
        {{ block.shopify_attributes }}
        {% if block.settings.url != blank %}
          onclick="window.location='{{ block.settings.url }}'"
          role="link"
          tabindex="0"
        {% endif %}
      >
        <div class="bould-work-card__logo-wrap">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              class: 'bould-work-card__logo-img',
              alt: block.settings.name
            }}
          {% elsif block.settings.image_asset != blank %}
            <img
              class="bould-work-card__logo-img"
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.name }}"
              width="600"
              height="600"
              loading="lazy"
            >
          {% else %}
            <span class="bould-work-card__initials">{{ block.settings.name | upcase | slice: 0, 2 }}</span>
          {% endif %}
        </div>

        <div class="bould-work-card__footer">
          <div class="bould-work-card__footer-left">
            <span class="bould-work-card__tag">{{ block.settings.category | default: 'Shopify Plus' }}</span>
            <h3 class="bould-work-card__name">{{ block.settings.name | default: 'Brand Name' }}</h3>
          </div>
          <div class="bould-work-card__footer-right">
            <span class="bould-work-card__year">{{ block.settings.year | default: '2025' }}</span>
            {% if block.settings.url != blank %}
              <div class="bould-work-card__cta-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 18 18" fill="none">
                  <path d="M3 15L15 3M15 3H6M15 3V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Bould — Work",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "Selected Work" },
    { "type": "text", "id": "title_line1", "label": "Title — line 1", "default": "Brands we've" },
    { "type": "text", "id": "title_line2", "label": "Title — line 2", "default": "helped grow." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View All Projects" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "case_study",
      "name": "Case Study",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Project image" },
        { "type": "text", "id": "image_asset", "label": "Logo asset filename", "info": "Optional. Theme asset filename (e.g. rubio-brothers-concrete-logo.png) used when no Project image is set." },
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand Name" },
        { "type": "text", "id": "category", "label": "Category", "default": "Shopify Plus" },
        { "type": "text", "id": "year", "label": "Year", "default": "2025" },
        { "type": "url", "id": "url", "label": "Project link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bould — Work",
      "blocks": [
        { "type": "case_study", "settings": { "name": "Joon Distribution", "category": "3D Store + Shopify Plus", "year": "2025" } },
        { "type": "case_study", "settings": { "name": "Dummiez", "category": "Virtual Try-On", "year": "2025" } },
        { "type": "case_study", "settings": { "name": "brand 3", "category": "Custom Development", "year": "2024" } },
        { "type": "case_study", "settings": { "name": "brand 4", "category": "AR Try-On + Shopify", "year": "2024" } },
        { "type": "case_study", "settings": { "name": "brand 5", "category": "Headless Commerce", "year": "2024" } },
        { "type": "case_study", "settings": { "name": "brand 6", "category": "Shopify Plus Migration", "year": "2023" } }
      ]
    }
  ]
}
{% endschema %}
